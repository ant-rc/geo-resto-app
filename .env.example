# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps SDK (native map rendering)
EXPO_PUBLIC_MAPS_API_KEY=your-google-maps-key

# Google Places API (restaurant search)
# Restrict this key by application (bundle id / referrer) in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-key
